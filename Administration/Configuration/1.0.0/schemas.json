{
  "configuration_version": "1.0.0",

  "workbook_schemas": {
    "standard_pricing_worksheet": {
      "description": "Schema used by SMS, Premium SMS and SMS MKT worksheets.",
      "header_row": 1,
      "all_other_countries_row": 2,
      "data_start_row": 3,

      "required_headers": {
        "country": "Country",
        "iso2": "ISO2",
        "baseline_price": "Baseline",
        "enterprise_price": "Enterprise"
      },

      "required_fields": [
        "Country",
        "ISO2",
        "Baseline",
        "Enterprise"
      ],

      "validation": {
        "country_required": true,
        "iso2_required": true,
        "iso2_must_be_unique": true,
        "baseline_price_must_be_numeric": true,
        "enterprise_price_must_be_numeric": true,
        "all_other_countries_row_required": true
      }
    },

    "local_pricing_worksheet": {
      "description": "Schema used by Local SMS and Local Premium SMS worksheets.",
      "header_row": 1,
      "data_start_row": 2,

      "required_headers": {
        "country": "Country",
        "baseline_price": "Baseline",
        "enterprise_price": "Enterprise"
      },

      "required_fields": [
        "Country",
        "Baseline",
        "Enterprise"
      ],

      "country_name_processing": {
        "remove_suffix": " - Local Companies",
        "trim_whitespace": true
      },

      "validation": {
        "country_required": true,
        "country_must_be_unique_after_processing": true,
        "baseline_price_must_be_numeric": true,
        "enterprise_price_must_be_numeric": true,
        "all_other_countries_row_required": false
      }
    },

    "sender_override_worksheet": {
      "description": "Schema used by the 2-way SMS worksheet for sender-specific US and Canada overrides.",
      "header_row": 1,
      "all_other_countries_row": 2,
      "data_start_row": 3,

      "required_headers": {
        "lookup_value": "Country",
        "baseline_price": "Baseline SMS 2-Way Outbound Rate",
        "enterprise_price": "Enterprise SMS 2-Way Outbound Rate"
      },

      "pricing_type_header_mapping": {
        "Baseline": "Baseline SMS 2-Way Outbound Rate",
        "Enterprise": "Enterprise SMS 2-Way Outbound Rate"
      },

      "required_fields": [
        "Country",
        "Baseline SMS 2-Way Outbound Rate",
        "Enterprise SMS 2-Way Outbound Rate"
      ],

      "validation": {
        "lookup_value_required": true,
        "lookup_value_must_be_unique": true,
        "iso2_must_be_unique": false,
        "configured_lookup_value_must_match_exactly_one_row": true,
        "baseline_price_must_be_numeric": true,
        "enterprise_price_must_be_numeric": true,
        "all_other_countries_row_required": true
      }
    }
  },

  "output_csv_schema": {
    "description": "CSV structure generated by the Pricing Generator.",

    "rows": {
      "band_definition_row": 1,
      "band_threshold_row": 2,
      "column_header_row": 3,
      "all_other_countries_row": 4,
      "country_data_start_row": 5
    },

    "columns": {
      "A": "Country",
      "B": "ISO2",
      "C": "Band1",
      "D": "Band2",
      "E": "Band3",
      "F": "Band4",
      "G": "Band5",
      "H": "Band6"
    },

    "band_definition_row": {
      "A": "Band1",
      "B": "Band2",
      "C": "Band3",
      "D": "Band4",
      "E": "Band5",
      "F": "Band6",
      "G": null,
      "H": null
    },

    "band_threshold_row": {
      "A": 0,
      "B": null,
      "C": null,
      "D": null,
      "E": null,
      "F": null,
      "G": null,
      "H": null
    },

    "column_header_row": {
      "A": "Country",
      "B": "ISO2",
      "C": "Band1",
      "D": "Band2",
      "E": "Band3",
      "F": "Band4",
      "G": "Band5",
      "H": "Band6"
    },

    "all_other_countries_row": {
      "country": null,
      "iso2": null,
      "price_column": "Band1",
      "price_source": "base_worksheet_all_other_countries_row",
      "remaining_band_values": null
    },

    "country_data_rows": {
      "country_source": "base_worksheet.Country",
      "iso2_source": "base_worksheet.ISO2",
      "price_column": "Band1",
      "remaining_band_values": null
    },

    "validation": {
      "exact_column_count": 8,
      "band_definition_row_column_count": 6,
      "band_threshold_row_column_count": 6,
      "column_header_row_column_count": 8,
      "country_data_row_column_count": 8,
      "all_other_countries_price_required": true,
      "country_price_required": true,
      "price_must_be_numeric": true
    }
  },

  "price_selection": {
    "Baseline": {
      "standard_worksheet_header": "Baseline",
      "local_worksheet_header": "Baseline",
      "sender_override_header": "Baseline SMS 2-Way Outbound Rate"
    },

    "Enterprise": {
      "standard_worksheet_header": "Enterprise",
      "local_worksheet_header": "Enterprise",
      "sender_override_header": "Enterprise SMS 2-Way Outbound Rate"
    }
  }
}