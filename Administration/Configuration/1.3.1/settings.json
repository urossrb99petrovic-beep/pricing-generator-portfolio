{
  "configuration_version": "1.3.1",
  "application_name": "Pricing Generator | Synthetic Portfolio Demo",
  "application_version": "1.3.1",
  "template_version": "1.3.1",
  "supported_currencies": [
    "USD",
    "EUR",
    "BRL"
  ],
  "default_currency": "USD",
  "pricing_workbook": {
    "folder_pattern": "{project_root}/demo_data/{currency}",
    "filename": "Synthetic Communications.xlsx"
  },
  "output": {
    "directory": "{project_root}/demo_output",
    "filename_pattern": "{currency} - {product} - {pricing_type} - template {MMM YYYY}.csv",
    "overwrite_existing_file": true,
    "encoding": "utf-8",
    "delimiter": ",",
    "decimal_separator": ".",
    "quoting": "minimal"
  },
  "logging": {
    "enabled": true,
    "directory": "{project_root}/demo_logs",
    "folder_structure": "{application_version}/{year}/{month}",
    "one_file_per_generation": true,
    "include_successful_generations": true,
    "include_failed_generations": true,
    "encoding": "utf-8",
    "format": "json"
  },
  "behaviour": {
    "open_output_folder_after_generation": false,
    "allow_partial_output": false
  }
}
